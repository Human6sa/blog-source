mixin categorySidebarLinks(items, listId, collapsed)
  ul.category-sidebar-links(id=listId hidden=collapsed)
    each item, index in items
      li
        if item.children && item.children.length
          - const childrenId = listId + '-' + index
          if item.path
            .category-sidebar-branch
              .category-sidebar-row
                a(href=url_for(item.path) class=item.active && 'category-sidebar-current' aria-current=item.current data-category-branch-link)= item.name
                button.category-sidebar-branch-toggle(type="button" data-category-branch-toggle aria-controls=childrenId aria-expanded=String(!!item.active) aria-label='展开或收起：' + item.name)
                  i.fas.fa-chevron-right(aria-hidden="true")
              +categorySidebarLinks(item.children, childrenId, !item.active)
          else
            details.category-sidebar-branch(open=item.active)
              summary(class=item.active && 'category-sidebar-current')
                span= item.name
                i.fas.fa-chevron-right(aria-hidden="true")
              +categorySidebarLinks(item.children, childrenId)
        else if item.path
          a(href=url_for(item.path) aria-current=item.current)= item.name

mixin categorySidebarDesktop(sidebar)
  aside.category-sidebar(data-category-disclosure)
    button.category-sidebar-toggle(type="button" data-category-toggle aria-expanded="false" aria-pressed="false" aria-controls="category-sidebar-panel" aria-label="固定分类侧栏" title="固定分类侧栏")
      i.fas.fa-sitemap(aria-hidden="true")
    nav#category-sidebar-panel.category-sidebar-panel(aria-label=sidebar.title data-category-panel inert)
      +categorySidebarLinks(sidebar.links, 'category-tree-desktop')

mixin categorySidebarCompact(sidebar)
  details.category-sidebar-compact
    summary= sidebar.title
    nav(aria-label=sidebar.title)
      +categorySidebarLinks(sidebar.links, 'category-tree-compact')
